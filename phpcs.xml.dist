<?xml version="1.0"?>
<ruleset name="WooCommerce Toasts">
  <description>WordPress coding, documentation, security and PHP compatibility checks.</description>
  <file>woocommerce-toasts.php</file>
  <file>uninstall.php</file>
  <file>includes</file>
  <file>templates</file>
  <arg name="extensions" value="php"/>
  <arg value="sp"/>
  <config name="testVersion" value="7.4-"/>
  <rule ref="WordPress"/>
  <rule ref="PHPCompatibilityWP"/>
  <rule ref="WordPress.WP.Capabilities"><properties><property name="custom_capabilities" type="array"><element value="manage_woocommerce"/></property></properties></rule>
  <rule ref="WordPress.WP.I18n"><properties><property name="text_domain" type="array"><element value="dynamic-notice-toasts-for-woocommerce"/></property></properties></rule>
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals"><properties><property name="prefixes" type="array"><element value="wc_toasts"/><element value="WC_Toasts"/></property></properties></rule>
</ruleset>
